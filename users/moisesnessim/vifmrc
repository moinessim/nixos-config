" vim: filetype=vifm :
" Shared Vifm configuration for Linux and macOS.

" Prefer Neovim on both macOS and Linux.
if executable('nvim')
    set vicmd=nvim
elseif executable('vim')
    set vicmd=vim
elseif executable('elvis')
    set vicmd=elvis\ -G\ termcap
elseif executable('vile')
    set vicmd=vile
elseif $EDITOR != ''
    let &vicmd = $EDITOR
endif

set syscalls
set trash
set history=100
set nofollowlinks
set sortnumbers
set undolevels=100
set vimhelp
set norunexec
set wildmenu
set wildstyle=popup
set suggestoptions=normal,visual,view,otherpane,keys,marks,registers
set ignorecase
set smartcase
set nohlsearch
set incsearch
set scrolloff=4
if !has('win')
    set slowfs=curlftpfs
endif
set timefmt='%Y/%m/%d %H:%M'
set statusline="  Hint: %z%= %A %10u:%-7g %15s %20d  "
set number relativenumber
colorscheme Default-256 Default

" Bookmarks
mark b ~/bin/
mark h ~/
mark d ~/Downloads/
mark c ~/code/
mark n ~/code/nix-config/

" Commands
command! df df -h %m 2> /dev/null
command! diff vim -d %f %F
command! zip zip -r %c.zip %f
command! run !! ./%f
command! make !!make %a
command! mkcd :mkdir %a | cd %a
command! vgrep vim "+grep %a"
command! reload :write | restart full

" FUSE mounts and archive handling
filetype *.ssh FUSE_MOUNT2|sshfs %PARAM %DESTINATION_DIR
filetype {*.zip,*.jar,*.war,*.ear,*.oxt,*.apkg},<application/zip,application/java-archive>
        \ {Mount with fuse-zip}
        \ FUSE_MOUNT|fuse-zip %SOURCE_FILE %DESTINATION_DIR,
        \ {View contents}
        \ unzip -l %f | less,
        \ {Extract here}
        \ unzip %c,
fileviewer {*.zip,*.jar,*.war,*.ear,*.oxt} unzip -l %f
filetype {*.tar,*.tar.bz2,*.tbz2,*.tgz,*.tar.gz,*.tar.xz,*.txz,*.tar.zst,*.tzst},<application/x-tar>
        \ {Mount with archivemount}
        \ FUSE_MOUNT|archivemount %SOURCE_FILE %DESTINATION_DIR,
        \ {Extract here}
        \ tar -xf %f,
fileviewer {*.tar,*.tar.bz2,*.tbz2,*.tgz,*.tar.gz,*.tar.xz,*.txz,*.tar.zst,*.tzst},<application/x-tar> tar -tf %c
filetype {*.rar},<application/x-rar>
        \ {Mount with rar2fs}
        \ FUSE_MOUNT|rar2fs %SOURCE_FILE %DESTINATION_DIR,
fileviewer {*.rar},<application/x-rar> unrar v %c
filetype {*.iso},<application/x-iso9660-image>
        \ {Mount with fuseiso}
        \ FUSE_MOUNT|fuseiso %SOURCE_FILE %DESTINATION_DIR,
filetype {*.7z},<application/x-7z-compressed>
        \ {Mount with fuse-7z}
        \ FUSE_MOUNT|fuse-7z %SOURCE_FILE %DESTINATION_DIR,
fileviewer {*.7z},<application/x-7z-compressed> 7z l %c
filetype *.ftp FUSE_MOUNT2|curlftpfs -o ftp_port=-,,disable_eprt %PARAM %DESTINATION_DIR %FOREGROUND

" Common file types
filextype {*.pdf},<application/pdf> zathura %c %i, apvlv %c, xpdf %c
fileviewer {*.pdf},<application/pdf> pdftotext -nopgbrk %c -
filextype {*.ps,*.eps,*.ps.gz},<application/postscript>
        \ {View in zathura}
        \ zathura %f,
        \ {View in gv}
        \ gv %c %i,
filextype {*.djvu},<image/vnd.djvu> zathura %f, apvlv %f
filetype {*.mid,*.kar} timidity %f
filetype {*.wav,*.mp3,*.flac,*.m4a,*.wma,*.ape,*.ac3,*.og[agx],*.spx,*.opus,*.aac,*.mpga},<audio/*>
        \ {Play using mpv}
        \ mpv --no-video %f %s,
        \ {Play using ffplay}
        \ ffplay -nodisp -hide_banner -autoexit %c,
fileviewer {*.wav,*.mp3,*.flac,*.m4a,*.wma,*.ape,*.ac3,*.og[agx],*.spx,*.opus,*.aac,*.mpga},<audio/*> ffprobe -hide_banner -pretty %c 2>&1
filextype {*.avi,*.mp4,*.wmv,*.dat,*.3gp,*.ogv,*.mkv,*.mpg,*.mpeg,*.vob,*.fl[icv],*.m2v,*.mov,*.webm,*.ts,*.mts,*.m4v,*.r[am],*.qt,*.divx,*.as[fx],*.unknown_video},<video/*>
        \ {View using ffplay}
        \ ffplay -fs -hide_banner -autoexit %f,
        \ {Play using mpv}
        \ mpv --no-video %f,
fileviewer {*.avi,*.mp4,*.wmv,*.dat,*.3gp,*.ogv,*.mkv,*.mpg,*.mpeg,*.vob,*.fl[icv],*.m2v,*.mov,*.webm,*.ts,*.mts,*.m4v,*.r[am],*.qt,*.divx,*.as[fx],*.unknown_video},<video/*> ffprobe -hide_banner -pretty %c 2>&1
filextype {*.xhtml,*.html,*.htm},<text/html>
        \ {Open with qutebrowser}
        \ qutebrowser %f %i,
        \ {Open with firefox}
        \ firefox %f &,
filetype {*.o},<application/x-object> nm %f | less
filetype {*.[1-8]},<text/troff> man ./%c
fileviewer {*.[1-8]},<text/troff> man ./%c | col -b
filextype {*.svg,*.svgz},<image/svg+xml> inkscape %f, inkview %f
filextype {*.cr2} darktable %f, rawtherapee %f
filextype {*.xcf} gimp %f
filextype {*.kra} krita %f
filextype {*.blend} blender %c
filextype {*.bmp,*.jpg,*.jpeg,*.png,*.gif,*.xpm},<image/*> sxiv %f, gpicview %c, shotwell
fileviewer {*.bmp,*.jpg,*.jpeg,*.png,*.gif,*.xpm},<image/*> identify %f
filetype *.md5 md5sum -c %f %S
filetype *.sha1 sha1sum -c %f %S
filetype *.sha256 sha256sum -c %f %S
filetype *.sha512 sha512sum -c %f %S
filetype {*.asc},<application/pgp-signature> !!gpg --verify %c
filetype {*.torrent},<application/x-bittorrent> ktorrent %f &
fileviewer {*.torrent},<application/x-bittorrent> dumptorrent -v %c, transmission-show %c
filextype {*.odt,*.doc,*.docx,*.xls,*.xlsx,*.odp,*.pptx,*.ppt},<application/vnd.openxmlformats-officedocument.*,application/msword,application/vnd.ms-excel> libreoffice %f &
fileviewer {*.doc},<application/msword> catdoc %c
fileviewer {*.docx},<application/vnd.openxmlformats-officedocument.wordprocessingml.document> docx2txt.pl %f -
filetype *.tudu tudu -f %c
filextype *.pro qtcreator %f &
filextype */ thunar %f &

" macOS-specific associations, enabled only when the command exists.
if executable('open')
    filetype {*.p12,*.pfx,*.pem,*.cer} open -a Preview.app
    filetype {*.dmg,*.pkg,*.img} open
endif

set vifminfo=dhistory,savedirs,chistory,state,tui,shistory,phistory,fhistory,dirstack,registers,bookmarks,bmarks

" Keyboard mappings
nnoremap s :shell<cr>
nnoremap S :sort<cr>
nnoremap w :view<cr>
vnoremap w :view<cr>gv
nnoremap gb :file &<cr>l
nnoremap I cw<c-a>
nnoremap cc cw<c-u>
nnoremap A cw
nnoremap ,c :write | edit $MYVIFMRC | restart full<cr>
nnoremap ,w :set wrap!<cr>
nnoremap <f3> :!less %f<cr>
nnoremap <f4> :edit<cr>
nnoremap <f5> :copy<cr>
nnoremap <f6> :move<cr>
nnoremap <f7> :mkdir<space>
nnoremap <f8> :delete<cr>
nnoremap <a-i> :sync<cr>
nnoremap <a-o> :sync %c<cr>
nnoremap <c-u> <c-w>x

" Platform-aware clipboard mappings.
if $WAYLAND_DISPLAY != '' && executable('wl-copy')
    nnoremap yd :!echo -n %d | wl-copy %i<cr>:echo expand('"%d') "is yanked to clipboard"<cr>
    nnoremap yf :!echo -n %c:p | wl-copy %i<cr>:echo expand('"%c:p') "is yanked to clipboard"<cr>
elseif $DISPLAY != '' && executable('xclip')
    nnoremap yd :!echo %d | xclip %i<cr>:echo expand('"%d') "is yanked to clipboard"<cr>
    nnoremap yf :!echo %c:p | xclip %i<cr>:echo expand('"%c:p') "is yanked to clipboard"<cr>
    nnoremap yn :!echo -n %c | xclip %i<cr>:echo expand('"%c') "is yanked to clipboard"<cr>
elseif executable('pbcopy')
    nnoremap yd :!echo -n %d | pbcopy %i<cr>:echo expand('"%d') "is yanked to clipboard"<cr>
    nnoremap yf :!echo -n %c:p | pbcopy %i<cr>:echo expand('"%c:p') "is yanked to clipboard"<cr>
    nnoremap yn :!echo -n %c | pbcopy %i<cr>:echo expand('"%c') "is yanked to clipboard"<cr>
    nnoremap yr :!echo -n %c:r | pbcopy %i<cr>:echo expand('"%c:r') "is yanked to clipboard"<cr>
    nnoremap yc :!pbcopy < %c:p<cr>:echo "Content of " expand('"%c:p') " is yanked to clipboard"<cr>
endif
